# .gitattributes — custom git behaviors for thebrana

# tasks.json uses a custom merge driver that preserves the highest task status.
# Never let a git merge downgrade a completed task to in_progress. (t-2132)
# Driver configured by bootstrap.sh → system/scripts/tasks-json-merge.sh
.claude/tasks.json merge=brana-tasks

# Escaped-defect log (ADR-082 §7): append-only JSONL written from concurrent
# branches/sessions — union merge keeps both sides' appends instead of
# conflicting; dropped lines would silently de-arm signal 5 (t-2895).
docs/ops/escaped-defects.jsonl merge=union
