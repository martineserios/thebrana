# .gitattributes — custom git behaviors for thebrana

# Periodic tasks.json snapshot uses a custom merge driver that preserves the
# highest task status. Never let a git merge downgrade a completed task to
# in_progress. (t-2132; repointed from .claude/tasks.json by ADR-091/t-3285 —
# the live ledger is untracked now, this driver guards the tracked snapshot's
# cross-branch merges instead.) Driver configured by bootstrap.sh → system/scripts/tasks-json-merge.sh
system/state/tasks-snapshot.json merge=brana-tasks

# Escaped-defect log (ADR-082 §7): append-only JSONL written from concurrent
# branches/sessions — union merge keeps both sides' appends instead of
# conflicting; dropped lines would silently de-arm signal 5 (t-2895).
docs/ops/escaped-defects.jsonl merge=union
